# === BASE DE DATOS (Neon) ===
# Obtener de: https://console.neon.tech -> Create project -> Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/avicola_produccion?sslmode=require"

# === JWT ===
JWT_SECRET="genera-un-seguro-aqui-cambia-esto"
JWT_EXPIRATION="24h"

# === CORS ===
# URL del frontend en Vercel (ej: https://avicola-erp.vercel.app)
CORS_ORIGIN="https://TU-PROYECTO.vercel.app"

# === MINIO (opcional para demo) ===
# Si no configuras MinIO, los archivos se guardan localmente en /uploads
MINIO_ENDPOINT=""
MINIO_PORT=9000
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="avicola-files"

# === SERVER ===
PORT=3001
NODE_ENV=production
