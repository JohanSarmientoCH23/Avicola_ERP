# ============================================
# AVICOLA ERP - Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/avicola_produccion"

# JWT Authentication
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRATION="24h"

# CORS
CORS_ORIGIN="http://localhost:3000"

# MinIO (Object Storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="change-this"
MINIO_SECRET_KEY="change-this"
MINIO_BUCKET="avicola-files"
